<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Sin permiso CAMERA a propósito: react-native-document-scanner-plugin
         (ver src/services/scan.ts) delega en el escáner de documentos de
         Google Play Services para el escaneo de cartas — es un componente
         del sistema, no la cámara de la propia app, así que no hace falta
         declarar ni pedir el permiso en runtime ("no permissions required"
         según su propia doc, mismo motivo por el que antes tampoco se
         declaraba con react-native-image-picker). -->


    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>

      <!-- Widget de cartas favoritas — ver src/services/favoritesWidget.ts. -->
      <receiver
        android:name=".widget.FavoriteCard"
        android:exported="false"
        android:label="Carta favorita">
        <intent-filter>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            <action android:name="com.pokev.WIDGET_CLICK" />
        </intent-filter>
        <meta-data
            android:name="android.appwidget.provider"
            android:resource="@xml/favorite_card_widget_info" />
      </receiver>
    </application>
</manifest>
