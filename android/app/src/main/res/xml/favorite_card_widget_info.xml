<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget de cartas favoritas — ver src/services/favoritesWidget.ts. El
  widget se actualiza (1) cuando la app lo empuja (requestWidgetUpdate, con
  datos frescos de la colección) y (2) sola, cada updatePeriodMillis, sin
  que la app esté abierta — pedido explícito: "que cada cierto tiempo se
  gire sola". 3600000 = 1h; Android igual pone un piso de 30min así se pida
  menos, así que da igual pedir menos. Sigue sin pegarle a Railway desde el
  proceso del widget en ninguno de los dos casos: ambos leen el cache local
  en AsyncStorage (ver favoriteCardWidgetTaskHandler) y solo eligen una
  carta distinta a la que ya se mostraba.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="180dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="3600000"
    android:initialLayout="@layout/rn_widget"
    android:previewImage="@drawable/favorite_card_widget_preview"
    android:description="@string/favorite_card_widget_description"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen">
</appwidget-provider>
